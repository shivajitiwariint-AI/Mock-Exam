    "bcryptjs": "^3.0.3",
    "mammoth": "^1.11.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "pdf-parse": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
