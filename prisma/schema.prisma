generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewQuestionSource {
  MANUAL
  AI_JD
  EXPERIENCE
}

enum InterviewQuestionCategory {
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  CODING
  HR
}

enum InterviewRoundType {
  HR
  TECHNICAL
  SYSTEM_DESIGN
  CODING
  BEHAVIORAL
  CASE_STUDY
}

enum ExperienceStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       UserProfile?
  activityLogs  ActivityLog[]
  notifications Notification[]
  subjects      Subject[]
  questions     Question[]
  exams         Exam[]
  examResults   ExamResult[]
  studySessions        StudySession[]
  interviewCompanies   InterviewCompany[]
  interviewQuestions   InterviewQuestion[]
  interviewExperiences InterviewExperience[]
}

model UserProfile {
  id     Int     @id @default(autoincrement())
  userId Int     @unique
  name   String
  avatar String?
  bio    String? @db.Text
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  module    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id            Int            @id @default(autoincrement())
  userId        Int
  name          String         @db.VarChar(100)
  description   String?        @db.Text
  color         String         @default("#6366F1") @db.VarChar(7)
  icon          String         @default("📚") @db.VarChar(10)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics        Topic[]
  exams         Exam[]
  studySessions StudySession[]

  @@index([userId])
  @@map("subjects")
}

model Topic {
  id            Int            @id @default(autoincrement())
  subjectId     Int
  name          String         @db.VarChar(100)
  description   String?        @db.Text
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopics     Subtopic[]
  questions     Question[]
  exams         Exam[]
  studySessions StudySession[]

  @@index([subjectId])
  @@map("topics")
}

model Subtopic {
  id        Int        @id @default(autoincrement())
  topicId   Int
  name      String     @db.VarChar(100)
  notes     String?    @db.LongText
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([topicId])
  @@map("subtopics")
}

model Question {
  id            Int              @id @default(autoincrement())
  userId        Int
  topicId       Int?
  subtopicId    Int?
  type          QuestionType     @default(MCQ)
  content       String           @db.Text
  explanation   String?          @db.Text
  difficulty    Difficulty       @default(MEDIUM)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic      Subtopic?        @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  answers       QuestionAnswer[]
  examQuestions ExamQuestion[]

  @@index([userId])
  @@index([topicId])
  @@map("questions")
}

model QuestionAnswer {
  id         Int      @id @default(autoincrement())
  questionId Int
  content    String   @db.Text
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_answers")
}

model Exam {
  id            Int            @id @default(autoincrement())
  userId        Int
  subjectId     Int?
  topicId       Int?
  title         String         @db.VarChar(150)
  timeLimitMins Int?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions     ExamQuestion[]
  results       ExamResult[]

  @@index([userId])
  @@map("exams")
}

model ExamQuestion {
  examId     Int
  questionId Int
  order      Int      @default(0)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
  @@map("exam_questions")
}

model ExamResult {
  id        Int      @id @default(autoincrement())
  examId    Int
  userId    Int
  score     Int
  totalQ    Int
  correctQ  Int
  timeTaken Int?
  answers   Json
  createdAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@map("exam_results")
}

model StudySession {
  id           Int      @id @default(autoincrement())
  userId       Int
  subjectId    Int?
  topicId      Int?
  durationMins Int
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic        Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("study_sessions")
}

model InterviewCompany {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String   @db.VarChar(150)
  website      String?  @db.VarChar(255)
  industry     String?  @db.VarChar(100)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescs     JobDescription[]
  questions    InterviewQuestion[]
  experiences  InterviewExperience[]
  @@index([userId])
  @@map("interview_companies")
}

model JobDescription {
  id             Int      @id @default(autoincrement())
  companyId      Int
  role           String   @db.VarChar(150)
  jdText         String   @db.LongText
  requiredSkills Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        InterviewCompany    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  questions      InterviewQuestion[]
  @@index([companyId])
  @@map("job_descriptions")
}

model InterviewQuestion {
  id         Int                        @id @default(autoincrement())
  userId     Int
  companyId  Int?
  jdId       Int?
  source     InterviewQuestionSource    @default(MANUAL)
  category   InterviewQuestionCategory  @default(TECHNICAL)
  question   String                     @db.Text
  answer     String?                    @db.LongText
  difficulty Difficulty
  whyAsked   String?                    @db.Text
  practiced  Boolean                    @default(false)
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    InterviewCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jd         JobDescription?   @relation(fields: [jdId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([companyId])
  @@index([jdId])
  @@map("interview_questions")
}

model InterviewExperience {
  id        Int              @id @default(autoincrement())
  userId    Int
  companyId Int?
  role      String           @db.VarChar(150)
  date      DateTime         @db.Date
  status    ExperienceStatus @default(INTERVIEWING)
  notes     String?          @db.Text
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   InterviewCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  rounds    InterviewRound[]
  @@index([userId])
  @@map("interview_experiences")
}

model InterviewRound {
  id           Int                @id @default(autoincrement())
  experienceId Int
  type         InterviewRoundType @default(TECHNICAL)
  roundNumber  Int                @default(1)
  notes        String?            @db.Text
  outcome      String?            @db.VarChar(50)
  createdAt    DateTime           @default(now())
  experience   InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  @@index([experienceId])
  @@map("interview_rounds")
}
