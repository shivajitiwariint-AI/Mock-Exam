generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       UserProfile?
  activityLogs  ActivityLog[]
  notifications Notification[]
  subjects      Subject[]
  questions     Question[]
  exams         Exam[]
  examResults   ExamResult[]
  studySessions StudySession[]
}

model UserProfile {
  id     Int     @id @default(autoincrement())
  userId Int     @unique
  name   String
  avatar String?
  bio    String? @db.Text
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  module    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id            Int            @id @default(autoincrement())
  userId        Int
  name          String         @db.VarChar(100)
  description   String?        @db.Text
  color         String         @default("#6366F1") @db.VarChar(7)
  icon          String         @default("📚") @db.VarChar(10)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics        Topic[]
  exams         Exam[]
  studySessions StudySession[]

  @@index([userId])
  @@map("subjects")
}

model Topic {
  id            Int            @id @default(autoincrement())
  subjectId     Int
  name          String         @db.VarChar(100)
  description   String?        @db.Text
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subject       Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subtopics     Subtopic[]
  questions     Question[]
  exams         Exam[]
  studySessions StudySession[]

  @@index([subjectId])
  @@map("topics")
}

model Subtopic {
  id        Int        @id @default(autoincrement())
  topicId   Int
  name      String     @db.VarChar(100)
  notes     String?    @db.LongText
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  topic     Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([topicId])
  @@map("subtopics")
}

model Question {
  id            Int              @id @default(autoincrement())
  userId        Int
  topicId       Int?
  subtopicId    Int?
  type          QuestionType     @default(MCQ)
  content       String           @db.Text
  explanation   String?          @db.Text
  difficulty    Difficulty       @default(MEDIUM)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic      Subtopic?        @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  answers       QuestionAnswer[]
  examQuestions ExamQuestion[]

  @@index([userId])
  @@index([topicId])
  @@map("questions")
}

model QuestionAnswer {
  id         Int      @id @default(autoincrement())
  questionId Int
  content    String   @db.Text
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_answers")
}

model Exam {
  id            Int            @id @default(autoincrement())
  userId        Int
  subjectId     Int?
  topicId       Int?
  title         String         @db.VarChar(150)
  timeLimitMins Int?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  questions     ExamQuestion[]
  results       ExamResult[]

  @@index([userId])
  @@map("exams")
}

model ExamQuestion {
  examId     Int
  questionId Int
  order      Int      @default(0)
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
  @@map("exam_questions")
}

model ExamResult {
  id        Int      @id @default(autoincrement())
  examId    Int
  userId    Int
  score     Int
  totalQ    Int
  correctQ  Int
  timeTaken Int?
  answers   Json
  createdAt DateTime @default(now())
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([examId])
  @@map("exam_results")
}

model StudySession {
  id           Int      @id @default(autoincrement())
  userId       Int
  subjectId    Int?
  topicId      Int?
  durationMins Int
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic        Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("study_sessions")
}
