# ---------------------------------------------------------------------------
# Database (MySQL 8)
# DATABASE_URL: connection string used by the app at runtime.
# Migrations are applied with: npx prisma migrate deploy
# (baseline an existing db-push database with: npx prisma migrate resolve --applied 20261118000000_init)
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://user:password@localhost:3306/mock_exam"

# ---------------------------------------------------------------------------
# Authentication (Auth.js v5). Generate with: npx auth secret
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# LLM (Groq). Required for AI question generation and the study assistant.
# Get a key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# ---------------------------------------------------------------------------
# Embeddings (optional). Groq does not offer an embeddings API, so retrieval
# uses deterministic local embeddings (stored as JSON) unless a separate
# OpenAI-compatible embeddings provider is configured here. The embeddings
# must be exactly 1536 dimensions.
# ---------------------------------------------------------------------------
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL=""

# ---------------------------------------------------------------------------
# Private file storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, ...)
# Required in production. Local development falls back to .data/uploads when
# S3_BUCKET is unset. Create a PRIVATE bucket.
# ---------------------------------------------------------------------------
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------------------
# Operational settings
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB="15"
# Protect the Vercel Cron endpoint. Vercel sends it as a Bearer token.
CRON_SECRET="replace-with-a-random-secret"

# ---------------------------------------------------------------------------
# Seeding (run once after deployment): npm run db:seed
# SEED_DEMO=true additionally creates demo subjects/questions/exams.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe12345!"
SEED_ADMIN_NAME="Platform Admin"
SEED_DEMO="false"
