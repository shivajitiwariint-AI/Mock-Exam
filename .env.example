# ─── Core ────────────────────────────────────────────────────────────────────
# Single MySQL/MariaDB database shared by PGOS and the merged Mock Exam app.
DATABASE_URL="mysql://root:@localhost:3306/pgcip_db"

# JWT cookie auth (pgcip_token). Use a long random value in production.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Public base URL used for generated links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional override for the base URL used by server-side link generation.
AUTH_URL=""

# ─── AI providers ────────────────────────────────────────────────────────────
# PGOS AI Coach: Anthropic first, then Ollama, then a local mock response.
ANTHROPIC_API_KEY=""
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:latest"

# Mock Exam AI generation and RAG study assistant (Groq / OpenAI-compatible).
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"

# Optional embeddings provider. When unset, deterministic local embeddings are used.
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL=""

# ─── Storage ─────────────────────────────────────────────────────────────────
# When S3_BUCKET / credentials are unset, uploads are stored under .data/uploads.
MAX_UPLOAD_MB="15"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ─── Jobs / seeding ──────────────────────────────────────────────────────────
CRON_SECRET="replace-with-a-random-cron-secret"
SEED_DEMO="false"
